<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Gokworks.KrProbe</AssemblyName>
    <SolidWorksInteropDir Condition="'$(SolidWorksInteropDir)' == ''">$(ProgramFiles)\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksInteropDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksInteropDir)/SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksInteropDir)/SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckSolidWorksInterop" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SolidWorksInteropDir)/SolidWorks.Interop.sldworks.dll')" Text="Set -p:SolidWorksInteropDir to the directory containing the installed SolidWorks.Interop.sldworks.dll and SolidWorks.Interop.swconst.dll." />
    <Error Condition="!Exists('$(SolidWorksInteropDir)/SolidWorks.Interop.swconst.dll')" Text="SolidWorks.Interop.swconst.dll is missing from SolidWorksInteropDir." />
  </Target>
</Project>
